{
  "name": "sf-shipment-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Salesforce shipment tracker: a MapLibre Lightning Web Component with Apex ETA and late-risk scoring",
  "license": "MIT",
  "scripts": {
    "lint": "eslint force-app/main/default/lwc",
    "test": "sfdx-lwc-jest",
    "test:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"force-app/**/*.{cls,trigger,js,html,css}\" \"scripts/**/*.apex\" \"demo/**/*.{js,css,html}\"",
    "prettier:check": "prettier --check \"force-app/**/*.{cls,trigger,js,html,css}\" \"scripts/**/*.apex\" \"demo/**/*.{js,css,html}\"",
    "vendor:maplibre": "node scripts/vendor-maplibre.js",
    "ci": "npm run lint && npm run prettier:check && npm run test:coverage",
    "build:demo": "node scripts/build-demo.js",
    "demo": "npm run build:demo && npx --yes serve demo-dist"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@eslint/js": "^9.39.5",
    "@lwc/eslint-plugin-lwc": "^3.5.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.14.0",
    "maplibre-gl": "5.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-apex": "^2.4.0"
  }
}
